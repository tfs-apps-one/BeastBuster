<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
        ******************************************************************
        通常音　の設定
        ******************************************************************
    -->
    <LinearLayout
        android:id="@+id/linearLayout_100"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearLayout00"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="5dp"
            android:layout_alignParentStart="true"
            android:backgroundTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="----"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/linearLayout5" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/linearLayout11"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/linearLayout00"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@null"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout00">

            <ImageView
                android:id="@+id/img_normal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="2"
                android:background="@null"
                android:src="@drawable/bell_off2" />

            <ToggleButton
                android:id="@+id/toggle_normal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_weight="5"
                android:background="@drawable/bak_normal"
                android:checked="false"
                android:textColor="@color/white"
                android:textOff="STOP"
                android:textOn="PLAY"
                android:textSize="50dp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout12"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/linearLayout11"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:backgroundTint="@null"
            android:background="@null"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout11">

            <ImageView
                android:id="@+id/img_bell_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:background="@null"
                android:src="@drawable/bell_list" />

            <Spinner
                android:id="@+id/sp_sound1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:theme="@style/SpinnerTheme"
                android:backgroundTint="@null"
                android:entries="@array/list_sound1"
                android:spinnerMode="dialog"/>

            <ImageView
                android:id="@+id/img_bell_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:background="@null"
                android:src="@drawable/bell_time" />

            <Spinner
                android:id="@+id/sp_interval"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:theme="@style/SpinnerTheme"
                android:entries="@array/list_interval"
                android:spinnerMode="dialog"/>

        </LinearLayout>

        <!--
            ******************************************************************
            緊急音　の設定
            ******************************************************************
        -->

        <LinearLayout
            android:id="@+id/linearLayout21"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_alignParentStart="true"
            android:orientation="horizontal"
            android:background="@null"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout13"
            >

            <ImageView
                android:id="@+id/img_emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="2"
                android:background="@null"
                android:src="@drawable/sos_off2" />

            <ToggleButton
                android:id="@+id/toggle_emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_weight="5"
                android:background="@drawable/bak_sos"
                android:checked="false"
                android:textColor="@color/white"
                android:textOff="STOP"
                android:textOn="PLAY"
                android:textSize="50dp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout22"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/linearLayout21"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:backgroundTint="@null"
            android:background="@null"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout21">

            <ImageView
                android:id="@+id/img_sos_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:background="@null"
                android:src="@drawable/sos_list" />

            <Spinner
                android:id="@+id/sp_sound2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:theme="@style/SpinnerTheme"
                android:entries="@array/list_sound2"
                android:spinnerMode="dialog"/>

            <ImageView
                android:id="@+id/img_sos_light"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:background="@null"
                android:src="@drawable/sos_light" />

            <Spinner
                android:id="@+id/sp_light2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:theme="@style/SpinnerTheme"
                android:entries="@array/list_light"
                android:spinnerMode="dialog"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout23"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:backgroundTint="@null"
            android:background="@null"
            android:layout_alignParentStart="true"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout22"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_volume_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:background="@null"
                android:src="@drawable/volume_up" />

            <SeekBar
                android:id="@+id/seek_volume1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:layout_marginTop="5dp"
                android:layout_marginStart="0dp"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="25dp"
                android:progress="5"
                android:max="15"
                android:progressBackgroundTint="@color/design_default_color_primary_variant"/>

            <ImageButton
                android:id="@+id/btn_img_info2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="1dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="1dp"
                android:layout_weight="1"
                android:background="@null"
                android:onClick="onTips"
                android:src="@drawable/info2"
                tools:ignore="SpeakableTextPresentCheck" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout99"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center|bottom"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="16dp">

        <!-- dummy text -->
        <!--
        <TextView
            android:id="@+id/text_dummy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="5dp"
            android:text="dummy"/>

        -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="5dp"
            ads:adSize="LARGE_BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/6300978111">
        </com.google.android.gms.ads.AdView>

    </LinearLayout>

    <!--
    本番
    ads:adUnitId="ca-app-pub-4924620089567925/6361767912">
    テスト
    ads:adUnitId="ca-app-pub-3940256099942544/6300978111">
    -->

</androidx.constraintlayout.widget.ConstraintLayout>